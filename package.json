{
  "name": "palari-art",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --host 0.0.0.0",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:masks": "node scripts/verify-avatar-masks.mjs",
    "verify:masks:generated": "node scripts/verify-avatar-masks.mjs --allow-unreviewed",
    "masks:generate": "node --env-file=.env.local scripts/generate-avatar-masks.mjs",
    "masks:review": "node scripts/record-mask-review.mjs",
    "check": "npm run verify:assets && npm run verify:masks && npm run build"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@fal-ai/client": "1.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
