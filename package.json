{
  "name": "palari-art",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages && node scripts/prepare-pages-artifact.mjs && node scripts/verify-pages-artifact.mjs",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --host 0.0.0.0",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:web-assets": "node scripts/verify-web-avatar-assets.mjs",
    "verify:web-masks": "node scripts/verify-web-mask-assets.mjs",
    "verify:pages": "node scripts/verify-pages-artifact.mjs",
    "verify:masks": "node scripts/verify-avatar-masks.mjs",
    "verify:framing": "node scripts/verify-avatar-framing.mjs",
    "verify:masks:generated": "node scripts/verify-avatar-masks.mjs --allow-unreviewed",
    "verify:attributes": "node scripts/verify-avatar-attributes.mjs",
    "handbook:assets:generate": "node scripts/generate-handbook-assets.mjs",
    "verify:handbook-assets": "node scripts/verify-handbook-assets.mjs",
    "verify:handbook": "node scripts/verify-handbook-assets.mjs && node scripts/verify-handbook.mjs",
    "fantasticos:import": "node --env-file=.env.local scripts/import-fantasticos.mjs",
    "fantasticos:clean": "node scripts/clean-fantasticos-foregrounds.mjs",
    "fantasticos:redraw:apply": "node scripts/apply-fantasticos-redraw.mjs",
    "masks:generate": "node --env-file=.env.local scripts/generate-avatar-masks.mjs",
    "masks:clean": "node scripts/clean-shirt-mask-components.mjs",
    "masks:review": "node scripts/record-mask-review.mjs",
    "mattes:generate": "node --env-file=.env.local scripts/generate-foreground-mattes.mjs",
    "mattes:review": "node scripts/record-mask-review.mjs --layer=foreground",
    "hair:generate": "node --env-file=.env.local scripts/generate-hair-masks.mjs",
    "hair:review": "node scripts/record-hair-review.mjs",
    "hair:mattes:generate": "python3 scripts/generate-hair-matting-layers.py",
    "hair:mattes:review": "node scripts/record-hair-matting-review.mjs",
    "framing:generate": "python3 scripts/generate-avatar-framing.py --all",
    "avatars:web:generate": "node scripts/generate-web-avatar-assets.mjs",
    "masks:web:generate": "node scripts/generate-web-mask-assets.mjs",
    "palari-v2:web:generate": "node scripts/generate-palari-v2-web-assets.mjs",
    "verify:palari-v2": "node scripts/verify-palari-v2.mjs",
    "check": "npm run verify:assets && npm run verify:web-assets && npm run verify:masks && npm run verify:web-masks && npm run verify:framing && npm run verify:attributes && npm run verify:handbook && npm run verify:palari-v2 && npm run build"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@fal-ai/client": "1.10.1",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
